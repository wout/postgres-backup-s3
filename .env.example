# --- required ---
DATABASE_URL=postgres://user:pass@host:5432/dbname
AGE_PUBLIC_KEY=age1...                # public recipient key, keep private key offline
S3_ENDPOINT=https://s3.example.com    # your S3-compatible endpoint (Garage, MinIO, ...)
S3_BUCKET=my-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- optional ---
S3_PATH=zow-v5/prod                   # object key prefix; one per DB
S3_REGION=us-east-1                   # some providers need a real value; us-east-1 is safe
S3_PROVIDER=Other                     # rclone S3 provider hint: AWS, Minio, Ceph, Other, ...
S3_ACL=private
BACKUP_SCHEDULE=0 * * * *             # cron expression, UTC
BACKUP_KEEP_DAYS=30                   # unset = keep forever
RUN_ON_START=false                    # take one backup at container start
TZ=UTC

# --- restore only (mount the key file into the container) ---
# AGE_IDENTITY_FILE=/run/secrets/age.key
